# Client profile: copy to client.env (gitignored) and fill in for the business you deploy for.
# Everything client-specific lives here, so the code and workflow stay generic.

CLIENT_SLUG=salon                                   # ids, paths: <slug>EnquiryIntake, /webhook/<slug>-enquiry
CLIENT_NAME="Example Salon"                         # used in the AI instructions and the reply sign-off
CLIENT_SHORT_NAME="Example Salon"                   # email subject tag and workflow name
CLIENT_DESCRIPTION="a beauty salon in Johannesburg" # "You are the enquiry assistant for <name>, <description>."
CLIENT_VOICE_HINT=''                                # optional, e.g. ' ("Hi lovely" is on brand)'
SITE_CONTENT_DIR=../example-site/content            # the website's Keystatic content folder (source of the knowledge base)

# Operator (you)
APP_NAME="Booking Assistant"                        # shown on the /about and /privacy pages and Google consent screen
CONTACT_EMAIL=you@example.com                       # privacy-request contact on those pages
GOOGLE_CRED_NAME="Google: send mail, sheets, calendar events"
