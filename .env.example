# Secrets (copy to .env, which is gitignored). Never commit real values.
ANTHROPIC_API_KEY=sk-ant-...
ENQUIRY_WEBHOOK_SECRET=            # long random string; the same value goes in the website's env
GOOGLE_CLIENT_ID=                  # Google Cloud OAuth client (web application)
GOOGLE_CLIENT_SECRET=
ENQUIRY_SHEET_ID=                  # Google Sheet with an "Enquiries" tab (15 columns, see build_workflow.py)
OWNER_NOTIFY_EMAIL=you@example.com # where enquiry notifications go

# Local n8n
N8N_OWNER_EMAIL=you@example.com
N8N_OWNER_PASSWORD=
N8N_GOOGLE_CRED_ID=                # id of the Google OAuth2 credential in n8n
# N8N_SERVER_ENCRYPTION_KEY is created by scripts/deploy.sh on first deploy

# Calendar slot suggestions (optional). CALENDAR_ID is used by local n8n; SERVER_CALENDAR_ID by deploy.sh.
# The calendar only needs to be shared as free/busy with the Google account in the n8n credential.
CALENDAR_ID=
SERVER_CALENDAR_ID=
OPENING_HOURS="tue-fri 09:00-18:00; sat 08:00-14:00"
SLOT_MINUTES=60
